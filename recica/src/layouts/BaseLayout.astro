---
import Meta from "@/components/seo/Meta.astro";
import Header from "@/components/site/Header.astro";
import Footer from "@/components/site/Footer.astro";
import "../styles/global.css";
import "@fontsource/inter";
import "@fontsource/jetbrains-mono";

export interface Props {
    title: string;
    description: string;
    image?: string;
    type?: "website" | "article";
    canonical?: string;
    noindex?: boolean;
}

const { title, description, image, type, canonical, noindex } = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
    <head>
        <Meta
            title={title}
            description={description}
            image={image}
            type={type}
            canonical={canonical}
            noindex={noindex}
        />
    </head>
    <body data-publication="technical-dossier">
        <a
            href="#main-content"
            class="skip-link"
        >
            Skip to content
        </a>

        <Header />

        <main id="main-content" class="main-site">
            <slot />
        </main>

        <Footer />
    </body>
</html>
