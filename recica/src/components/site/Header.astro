---
import { navigation, siteConfig } from "@/lib/site-content";

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const isHome = pathname === "/";

function resolveHref(href: string) {
  if (href.startsWith("#")) return isHome ? href : `/${href}`;
  return href;
}

function isCurrent(href: string) {
  return !href.startsWith("#") && href === pathname;
}
---

<header class="site-header">
  <div class="shell site-header__shell">
    <a href="/" class="site-brand" aria-label="recica.dev home">
      <span class="site-brand__mark" aria-hidden="true">DR</span>
      <span>{siteConfig.domain}</span>
    </a>

    <a
      href={`mailto:${siteConfig.email}`}
      class="action-link action-link--primary site-header__email"
    >
      Email
    </a>

    <nav class="site-nav" aria-label="Primary">
      {
        navigation.map((item) => (
          <a
            href={resolveHref(item.href)}
            aria-current={isCurrent(item.href) ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
