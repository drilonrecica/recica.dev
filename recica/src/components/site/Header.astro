---
import { navigation, siteConfig } from "@/lib/site-content";

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const isHome = pathname === "/";

function resolveHref(href: string) {
  if (href.startsWith("#")) return isHome ? href : `/${href}`;
  return href;
}

function isCurrent(href: string) {
  return !href.startsWith("#") && href === pathname;
}
---

<header class="site-header">
  <div class="shell site-header__shell">
    <a href="/" class="site-brand" aria-label="recica.dev home">
      <svg class="site-brand__mark" viewBox="0 0 64 64" aria-hidden="true">
        <path class="site-brand__corner" d="M21 59H5V43" />
        <path d="M43 5H59V21" />
        <path d="M18 16H30A16 16 0 0 1 46 32A16 16 0 0 1 30 48H18Z" stroke-width="7" />
      </svg>
      <span>{siteConfig.domain}</span>
    </a>

    <a
      href={`mailto:${siteConfig.email}`}
      class="action-link action-link--primary site-header__email"
    >
      Email
    </a>

    <nav class="site-nav" aria-label="Primary">
      {
        navigation.map((item) => (
          <a
            href={resolveHref(item.href)}
            aria-current={isCurrent(item.href) ? "page" : undefined}
            target={item.external ? "_blank" : undefined}
            rel={item.external ? "noreferrer" : undefined}
          >
            {item.label}
            {item.external && <span aria-hidden="true"> ↗</span>}
          </a>
        ))
      }
    </nav>
  </div>
</header>
