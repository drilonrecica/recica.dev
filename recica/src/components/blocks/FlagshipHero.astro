---
import Portrait from "@/components/blocks/Portrait.astro";
import { heroActions, heroFacts, siteConfig } from "@/lib/site-content";
---

<section class="hero" aria-labelledby="hero-title">
  <div class="shell">
    <div class="hero__shell">
      <div>
        <p class="kicker">{siteConfig.role}</p>
        <h1 id="hero-title" class="hero__name">{siteConfig.name}</h1>
        <p class="hero__role">
          Android since {siteConfig.yearsSince}. Flutter, backend, and
          infrastructure when the product needs it.
        </p>
        <p class="hero__pitch">{siteConfig.pitch}</p>
        <div class="actions" aria-label="Primary actions">
          {
            heroActions.map((action) => (
              <a
                href={action.href}
                class={`action-link action-link--${action.style ?? "text"}`}
              >
                {action.label}
              </a>
            ))
          }
        </div>
      </div>
      <Portrait />
    </div>

    <dl class="facts" style="margin-top: clamp(2.5rem, 5vw, 4rem)">
      {
        heroFacts.map((fact) => (
          <div>
            <dt class="label">{fact.label}</dt>
            <dd>{fact.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
