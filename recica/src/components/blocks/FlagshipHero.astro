---
import { heroActions, sectionCopy, siteConfig } from '@/lib/site-content';

const capabilities = [
	['01', 'Android product engineering'],
	['02', 'Legacy modernization'],
	['03', 'Accessible delivery'],
	['04', '0-to-1 product systems']
];
---

<section class="hero-stage" aria-labelledby="hero-title">
	<div class="hero-stage__shell">
		<div class="hero-copy">
			<div class="hero-copy__meta">
				<p class="dossier-index">DOSSIER 001 / 2026</p>
				<p>Static · Independent</p>
			</div>
			<h1 id="hero-title" class="hero-title">{siteConfig.name}</h1>
			<p class="hero-role">Senior mobile &amp;<br />product engineer.</p>
			<p class="hero-support">{siteConfig.supportingLine}</p>
			<p class="hero-intro">{sectionCopy.hero.intro}</p>

			<div class="hero-actions" aria-label="Primary actions">
				{
					heroActions.map((action) => (
						<a
							href={action.href}
							class={`action-link action-link--${action.style ?? 'text'}`}
							target={action.external ? '_blank' : undefined}
							rel={action.external ? 'noreferrer' : undefined}
						>
							{action.label}
						</a>
					))
				}
			</div>
		</div>

		<div class="capability-plate" aria-label="Core capabilities">
			<div class="capability-plate__head">
				<span>Operating range</span>
				<span>12+ years</span>
			</div>
			<ol>
				{capabilities.map(([number, label]) => (
					<li><span>{number}</span><strong>{label}</strong></li>
				))}
			</ol>
			<div class="capability-plate__signal" aria-hidden="true">
				<span></span><span></span><span></span><span></span>
			</div>
			<p class="capability-plate__foot">Architecture / Delivery / Product judgment</p>
		</div>
	</div>
</section>
