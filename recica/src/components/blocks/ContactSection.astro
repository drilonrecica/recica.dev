---
import { contactLinks, sectionCopy, siteConfig } from "@/lib/site-content";
---

<section id="contact" class="shell section section--stack" aria-labelledby="contact-title">
  <div class="band contact-band">
    <div>
      <p class="kicker">{sectionCopy.contact.kicker}</p>
      <h2 id="contact-title">{sectionCopy.contact.title}</h2>
      <p class="lede">{sectionCopy.contact.description}</p>
      <p class="contact-band__email">
        <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
      </p>
    </div>

    <div class="contact-grid">
      {
        contactLinks.map((link) => (
          <a
            href={link.href}
            data-primary={link.primary ? "" : undefined}
            target={link.href.startsWith("http") ? "_blank" : undefined}
            rel={link.href.startsWith("http") ? "noreferrer" : undefined}
          >
            <h3>{link.label}</h3>
            <p>{link.description}</p>
          </a>
        ))
      }
    </div>
  </div>
</section>
