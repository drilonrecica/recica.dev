---
import { caseStudies, sectionCopy } from '@/lib/site-content';
---

<section id="work" class="dossier-section anchor-target">
	<header class="dossier-section__header">
		<p class="dossier-index">02 / SELECTED WORK</p>
		<h2>{sectionCopy.work.title}</h2>
		<p>{sectionCopy.work.description}</p>
	</header>

	<div class="case-index">
		{
			caseStudies.map((study, index) => (
				<article class="case-entry">
					<p class="case-entry__number">CS-{String(index + 1).padStart(2, '0')}</p>
					<div class="case-entry__identity">
						<p class="case-entry__period">{study.period}</p>
						<h3>{study.title}</h3>
						<p>{study.role}</p>
					</div>
					<div class="case-entry__brief">
						<p>{study.summary}</p>
						<ul class="tag-row" aria-label="Technologies and disciplines">
							{study.stack.map((tag) => <li>{tag}</li>)}
						</ul>
					</div>
					<a href={`/work/${study.slug}`} class="case-entry__link">
						Read case study <span aria-hidden="true">↗</span>
					</a>
				</article>
			))
		}
	</div>
</section>
