---
import { featuredTools, sectionCopy } from '@/lib/site-content';
---

<section id="tools" class="dossier-section anchor-target">
	<header class="dossier-section__header">
		<p class="dossier-index">03 / INDEPENDENT PUBLICATIONS</p>
		<h2>{sectionCopy.tools.title}</h2>
		<p>{sectionCopy.tools.description}</p>
	</header>

	<div class="publication-index">
			{
				featuredTools.map((tool, index) => (
					<a href={tool.href} target="_blank" rel="noreferrer" class="publication-entry">
						<span>TL-{String(index + 1).padStart(2, '0')}</span>
						<div><p>{tool.category}</p><h3>{tool.name}</h3></div>
						<p class="publication-entry__copy">{tool.description}</p>
						<span aria-hidden="true">↗</span>
					</a>
				))
			}
	</div>

	<div class="publication-links">
		<p>{sectionCopy.tools.footer}</p>
		<a href="https://tools.recica.dev" target="_blank" rel="noreferrer">Explore Recica Tools</a>
		<a href="https://labs.recica.dev" target="_blank" rel="noreferrer">Explore Labs</a>
	</div>
</section>
