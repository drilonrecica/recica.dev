---
import { featuredTools, sectionCopy, siteConfig } from "@/lib/site-content";
---

<section id="tools" class="shell section section--split" aria-labelledby="tools-title">
  <header class="section__header">
    <p class="kicker">{sectionCopy.tools.kicker}</p>
    <h2 id="tools-title">{sectionCopy.tools.title}</h2>
    <p class="lede">{sectionCopy.tools.description}</p>
  </header>

  <div>
    <div class="tool-list">
      {
        featuredTools.map((tool) => (
          <a href={tool.href} target="_blank" rel="noreferrer" class="tool-entry">
            <p class="label">{tool.category}</p>
            <h3>{tool.name}</h3>
            <p>{tool.description}</p>
            <span aria-hidden="true">↗</span>
          </a>
        ))
      }
    </div>

    <div class="tool-links">
      <p>{sectionCopy.tools.footer}</p>
      <a href={siteConfig.toolsUrl} target="_blank" rel="noreferrer" class="text-link">
        Explore Recica Tools
      </a>
      <a href={siteConfig.labsUrl} target="_blank" rel="noreferrer" class="text-link">
        Explore Labs
      </a>
    </div>
  </div>
</section>
