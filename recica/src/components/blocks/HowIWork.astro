---
import { howIWorkSummary, principles, sectionCopy } from "@/lib/site-content";
---

<section id="about" class="shell section section--split" aria-labelledby="about-title">
  <header class="section__header">
    <p class="kicker">{sectionCopy.about.kicker}</p>
    <h2 id="about-title">{sectionCopy.about.title}</h2>
    <p class="lede">{howIWorkSummary}</p>
    <a href="/about" class="text-link">
      Read the full profile
    </a>
  </header>

  <ul class="principles">
    {
      principles.map((principle) => (
        <li>
          <h3>{principle.title}</h3>
          <p>{principle.description}</p>
        </li>
      ))
    }
  </ul>
</section>
