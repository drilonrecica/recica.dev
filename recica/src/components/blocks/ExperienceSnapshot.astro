---
import { experienceItems, sectionCopy, siteConfig } from '@/lib/site-content';
---

<section id="experience" class="dossier-section anchor-target">
	<header class="dossier-section__header">
		<p class="dossier-index">04 / EXPERIENCE LOG</p>
		<h2>{sectionCopy.experience.title}</h2>
		<a href={siteConfig.cvPath} class="text-link">Download the full CV ↗</a>
	</header>

	<div class="timeline-list">
			{
				experienceItems.map((item, index) => (
					<article class="timeline-item">
						<p class="timeline-item__index">{String(index + 1).padStart(2, '0')}</p>
						<p class="timeline-item__period">{item.period}</p>
						<div>
							<h3>{item.title}</h3>
							<p class="timeline-item__role">{item.role}</p>
							<p class="timeline-item__summary">{item.summary}</p>
						</div>
					</article>
				))
			}
	</div>
</section>
