---
import { proofItems, sectionCopy } from '@/lib/site-content';
---

<section class="dossier-section dossier-section--proof">
	<header class="dossier-section__header">
		<p class="dossier-index">01 / OPERATING PROFILE</p>
		<h2>{sectionCopy.proof.title}</h2>
		<p>{sectionCopy.proof.description}</p>
	</header>

	<div class="proof-grid">
			{
				proofItems.map((item, index) => (
					<article class="proof-item">
						<p class="proof-item__index">{String(index + 1).padStart(2, '0')}</p>
						<h3>{item.title}</h3>
						<p>{item.description}</p>
					</article>
				))
			}
	</div>
</section>
