---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="404 — Dossier entry not found | Drilon Reçica"
  description="This recica.dev dossier entry does not exist."
  canonical="/404"
  noindex={true}
>
  <section class="not-found">
    <p class="dossier-index">ERROR / 404</p>
    <h1>Dossier entry not found</h1>
    <p>
      The requested record is not part of this publication. Return to the main
      dossier or review the selected work index.
    </p>
    <div>
      <a href="/" class="action-link action-link--primary">Return home</a>
      <a href="/#work" class="action-link action-link--secondary"
        >Selected work</a
      >
    </div>
  </section>
</BaseLayout>
