---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page not found | Drilon Reçica"
  description="This page does not exist on recica.dev."
  canonical="/404"
  noindex={true}
>
  <section class="shell not-found">
    <p class="kicker">404</p>
    <h1>Page not found</h1>
    <p>
      The address may be mistyped or the page may have moved. Start from the
      homepage or go straight to the selected work.
    </p>
    <div class="actions">
      <a href="/" class="action-link action-link--primary">Go to the homepage</a>
      <a href="/#work" class="action-link action-link--secondary">Selected work</a>
    </div>
  </section>
</BaseLayout>
