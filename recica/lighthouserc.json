{
  "ci": {
    "collect": {
      "startServerCommand": "env --chdir=recica ./node_modules/.bin/astro preview --host 127.0.0.1 --port 4173",
      "startServerReadyPattern": "Local",
      "url": [
        "http://127.0.0.1:4173/",
        "http://127.0.0.1:4173/cv",
        "http://127.0.0.1:4173/work/wohin-du-willst"
      ],
      "numberOfRuns": 1,
      "settings": {
        "chromeFlags": "--no-sandbox"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 1
          }
        ]
      }
    }
  }
}
